# Шаблон окружения. Скопируйте в .env и заполните значения.
#   cp .env.example .env
#
# .env в git не попадает. Здесь НИКОГДА не должно быть реальных значений.

# Вызывать ли Neural4D. При false генерация сразу отдаёт шаблонный дом —
# так работают над дизайном, не дожидаясь вендора и не тратя на него деньги.
# По умолчанию выключено, чтобы забытый ключ не начал слать запросы.
NEURAL4D_ENABLED=false

# Ключ Neural4D. Читается только на сервере, в браузер не попадает.
# Пока NEURAL4D_ENABLED=false — не читается вовсе.
NEURAL4D_API_KEY=

# Адрес API вендора. Задаётся только на сервере: клиент не может на него
# повлиять, иначе эндпоинт превратился бы в открытый прокси (SSRF).
NEURAL4D_API_URL=

# ─── PostgreSQL (Yandex Cloud Managed Service for PostgreSQL) ───────────────
# Все переменные читаются только на сервере: префикса NEXT_PUBLIC_ нет ни у
# одной, поэтому в браузер они не попадают.

# FQDN хоста базы. В консоли Yandex Cloud: кластер → Хосты → колонка «Имя».
# Выглядит примерно так: rc1a-xxxxxxxxxxxx.mdb.yandexcloud.net
DB_HOST=

# Порт пулера соединений (Odyssey). У самой БД порт 5432, но подключаться
# правильнее через пулер — он экономит соединения.
DB_PORT=6432

DB_NAME=opusgroup
DB_USER=opusgroup_app

# Пароль. Хранится только здесь, в .env, который в git не попадает.
DB_PASSWORD=

# Режим TLS: require (по умолчанию) или disable для локальной базы без шифрования.
DB_SSL=require

# Путь к корневому сертификату Yandex Cloud. Пока он не задан, соединение
# шифруется, но подлинность сервера не проверяется. Скачать один раз:
#   mkdir -p ~/.postgresql && curl -o ~/.postgresql/root.crt \
#     https://storage.yandexcloud.net/cloud-certs/CA.pem
# и указать сюда полный путь к файлу.
DB_SSL_ROOT_CERT=
