# Шаблон окружения. Скопируйте в .env и заполните значения.
#   cp .env.example .env
#
# .env в git не попадает. Здесь НИКОГДА не должно быть реальных значений.

# Вызывать ли Neural4D. При false генерация сразу отдаёт шаблонный дом —
# так работают над дизайном, не дожидаясь вендора и не тратя на него деньги.
# По умолчанию выключено, чтобы забытый ключ не начал слать запросы.
NEURAL4D_ENABLED=false

# Ключ Neural4D. Читается только на сервере, в браузер не попадает.
# Пока NEURAL4D_ENABLED=false — не читается вовсе.
NEURAL4D_API_KEY=

# Адрес API вендора. Задаётся только на сервере: клиент не может на него
# повлиять, иначе эндпоинт превратился бы в открытый прокси (SSRF).
NEURAL4D_API_URL=
