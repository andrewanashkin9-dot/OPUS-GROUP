# Шаблон окружения. Скопируйте в .env и заполните значения.
#   cp .env.example .env
#
# .env в git не попадает. Здесь НИКОГДА не должно быть реальных значений.

# Вызывать ли Neural4D. При false генерация сразу отдаёт шаблонный дом —
# так работают над дизайном, не дожидаясь вендора и не тратя на него деньги.
# По умолчанию выключено, чтобы забытый ключ не начал слать запросы.
NEURAL4D_ENABLED=false

# Ключ Neural4D. Читается только на сервере, в браузер не попадает.
# Пока NEURAL4D_ENABLED=false — не читается вовсе.
NEURAL4D_API_KEY=

# Адрес API вендора. Задаётся только на сервере: клиент не может на него
# повлиять, иначе эндпоинт превратился бы в открытый прокси (SSRF).
NEURAL4D_API_URL=

# ─── PostgreSQL (Yandex Cloud Managed Service for PostgreSQL) ───────────────
# Все переменные читаются только на сервере: префикса NEXT_PUBLIC_ нет ни у
# одной, поэтому в браузер они не попадают.

# FQDN хоста базы. В консоли Yandex Cloud: кластер → Хосты → колонка «Имя».
# Выглядит примерно так: rc1b-xxxxxxxxxxxxxxxx.mdb.yandexcloud.net
# Скопированные из адресной строки `https://` и слэш на конце срезаются
# автоматически — но имя должно быть видно в публичном DNS, то есть у хоста
# должен быть включён публичный доступ.
DB_HOST=

# Порт пулера соединений (Odyssey). У самой БД порт 5432, но подключаться
# правильнее через пулер — он экономит соединения.
DB_PORT=6432

DB_NAME=opusgroup
DB_USER=opusgroup_app

# Пароль. Хранится только здесь, в .env, который в git не попадает.
DB_PASSWORD=

# ВАЖНО про деплой: миграции при сборке берут сеансовый замок
# (pg_advisory_lock), а он не держится между транзакциями, если пулер
# работает в режиме Transaction. В переменных окружения Vercel надёжнее
# указать прямой порт 5432 — см. README, «Миграции при деплое».

# Режим TLS: require (по умолчанию) или disable для локальной базы без шифрования.
DB_SSL=require

# Путь к корневому сертификату Yandex Cloud. Пока он не задан, соединение
# шифруется, но подлинность сервера не проверяется. Скачать один раз:
#   mkdir -p ~/.postgresql && curl -o ~/.postgresql/root.crt \
#     https://storage.yandexcloud.net/cloud-certs/CA.pem
# и указать сюда полный путь к файлу.
DB_SSL_ROOT_CERT=

# ─── Авторизация ────────────────────────────────────────────────────────────
# Секрет для подписи JWT. Любой, кто его знает, может выписать себе токен с
# ролью admin — это такой же секрет, как пароль от базы.
# Сгенерировать:  openssl rand -base64 48
# Минимум 32 символа, иначе приложение откажется его использовать.
AUTH_JWT_SECRET=

# ─── Т-Касса (интернет-эквайринг Т-Банка) ───────────────────────────────────
# Приём платежей выключен по умолчанию: забытый в окружении ключ не должен
# начать списывать деньги сам.
TKASSA_ENABLED=false

# Ключи терминала. Тестовые выдают в личном кабинете Т-Бизнеса вместе с
# тестовым терминалом; боевые — после регистрации ИП/ООО. Пароль терминала —
# такой же секрет, как пароль от базы: им подписываются все запросы.
TKASSA_TERMINAL_KEY=
TKASSA_PASSWORD=

# Адрес API. Тестовый терминал работает по тому же адресу, что и боевой —
# режим определяется ключом терминала, а не адресом.
TKASSA_API_URL=https://securepay.tinkoff.ru/v2/

# Цена подписки в рублях. Строкой, с двумя знаками.
TKASSA_SUBSCRIPTION_PRICE=700.00

# Публичный адрес приложения: куда банк вернёт человека после оплаты и куда
# он будет слать уведомления (/api/payments/tkassa/webhook).
APP_BASE_URL=

# ─── Комиссия ───────────────────────────────────────────────────────────────
# Обе части по умолчанию нулевые. Значение «как обычно берут» по умолчанию
# означало бы, что забытая настройка молча удерживает деньги у исполнителей.

# Доля от суммы сделки: 0.07 — это 7%. От 0 до 1.
COMMISSION_RATE=0

# Агентское вознаграждение — фиксированная сумма за сделку, в рублях.
COMMISSION_AGENT_FEE=0

# ─── Почта ──────────────────────────────────────────────────────────────────
# Пока не задан, письма (подтверждение адреса, сброс пароля) печатаются в лог
# сервера вместе со ссылкой — обе функции работают, просто без доставки.
SMTP_URL=

# ─── ВРЕМЕННЫЕ ДЕМО-ВСТАВКИ ────────────────────────────────────────────────
# Переменной здесь больше нет. Демо-функции (переключатель роли, чат с
# демо-менеджерами, демо-отзывы) включены всегда и настройки не требуют.
# Убираются они только удалением кода — список файлов в TODO_BEFORE_LAUNCH.md.

# ─── Деплой ────────────────────────────────────────────────────────────────
# Аварийный выключатель миграций при сборке. Ставится в панели Vercel и
# только на время: миграция ломает сборку, а выкатить нужно сейчас. Схему
# после этого догоняют руками. По умолчанию не задан.
SKIP_DEPLOY_MIGRATIONS=
