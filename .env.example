# Шаблон окружения. Скопируйте в .env и заполните значения.
#   cp .env.example .env
#
# .env в git не попадает. Здесь НИКОГДА не должно быть реальных значений.

# Каким провайдером генерировать 3D: neural4d | genapi
# Переключение между вендорами — только эта строка, код менять не нужно.
ACTIVE_3D_PROVIDER=neural4d

# --- Neural4D ---
# Читается только на сервере, в браузер не попадает.
NEURAL4D_API_KEY=
# Адрес API. Задаётся только на сервере: клиент на него влиять не может,
# иначе маршрут стал бы открытым прокси (SSRF).
NEURAL4D_API_URL=

# --- GenAPI ---
# Отдельный ключ. НЕ переиспользуйте ключ Neural4D: у вендоров разные
# аккаунты и биллинг, а общий ключ пришлось бы отзывать сразу у обоих.
GENAPI_KEY=
GENAPI_URL=
# Какую модель просить у агрегатора: meshy | tripo3d | rodin
GENAPI_MODEL=
