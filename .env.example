# Шаблон окружения. Скопируйте в .env и заполните значения.
#   cp .env.example .env
#
# .env в git не попадает. Здесь НИКОГДА не должно быть реальных значений.

# Ключ Neural4D. Читается только на сервере, в браузер не попадает.
NEURAL4D_API_KEY=

# Адрес API вендора. Задаётся только на сервере: клиент не может на него
# повлиять, иначе эндпоинт превратился бы в открытый прокси (SSRF).
NEURAL4D_API_URL=
