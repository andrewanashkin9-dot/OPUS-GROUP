# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...кроме шаблона без значений: он документирует, какие переменные нужны.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Higgsfield CLI companion skills (installed by `npx skills add higgsfield-ai/skills`).
# Tooling for an unrelated product, not part of this project: ~1.4 MB of skill
# definitions that would otherwise land in a frontend PR diff. Regenerate with
# that command if they are wanted again. Scoped rather than ignoring all of
# .claude/, so a real .claude/settings.json can still be tracked.
/.agents/
/.claude/skills/
/skills-lock.json
